{
  "dashboard": {
    "title": "Lumen Chain — Production",
    "uid": "lumen-production",
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "15s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Uptime (lumen-chain)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "up{job=\"lumen-chain\"}",
            "legendFormat": "lumen-chain",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "0", "text": "DOWN"},
              {"type": "value", "value": "1", "text": "UP"}
            ],
            "colors": [
              {"color": "red", "value": 0},
              {"color": "green", "value": 1}
            ]
          }
        }
      },
      {
        "id": 2,
        "title": "Response Time P95",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 4, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"lumen-chain\"}[5m])) by (le))",
            "legendFormat": "lumen-chain p95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(mcp_request_duration_seconds_bucket{job=\"mcp-proxy\"}[5m])) by (le))",
            "legendFormat": "mcp-proxy p95",
            "refId": "B"
          }
        ],
        "yAxes": [
          {"label": "seconds", "format": "s"},
          {"format": "short"}
        ],
        "alert": {
          "name": "HighLatency",
          "conditions": [
            {
              "evaluator": {"params": [1], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "frequency": "1m",
          "handler": 1,
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 3,
        "title": "P2P Peers",
        "type": "graph",
        "gridPos": {"h": 6, "w": 6, "x": 16, "y": 0},
        "targets": [
          {
            "expr": "lumen_p2p_peers",
            "legendFormat": "peers",
            "refId": "A"
          }
        ],
        "alert": {
          "name": "LowPeers",
          "conditions": [
            {
              "evaluator": {"params": [3], "type": "lt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "frequency": "1m",
          "handler": 1
        }
      },
      {
        "id": 4,
        "title": "Request Rate (rpm)",
        "type": "graph",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"lumen-chain\"}[5m])) by (method) * 60",
            "legendFormat": "lumen-chain {{method}}",
            "refId": "A"
          },
          {
            "expr": "sum(rate(http_requests_total{job=\"perps-funding-pulse\"}[5m])) by (code) * 60",
            "legendFormat": "perps {{code}}",
            "refId": "B"
          },
          {
            "expr": "sum(rate(mcp_requests_total{job=\"mcp-proxy\"}[5m])) * 60",
            "legendFormat": "mcp-proxy",
            "refId": "C"
          }
        ],
        "yAxes": [
          {"label": "requests / min", "format": "short"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Disk Usage",
        "type": "gauge",
        "gridPos": {"h": 6, "w": 6, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "(node_filesystem_size_bytes{mountpoint=\"/\"} - node_filesystem_avail_bytes{mountpoint=\"/\"}) / node_filesystem_size_bytes{mountpoint=\"/\"} * 100",
            "legendFormat": "disk %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 90}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": {"h": 6, "w": 6, "x": 18, "y": 8},
        "targets": [
          {
            "expr": "process_resident_memory_bytes{job=\"lumen-chain\"} / 1024 / 1024",
            "legendFormat": "lumen-chain (MiB)",
            "refId": "A"
          },
          {
            "expr": "process_resident_memory_bytes{job=\"mcp-proxy\"} / 1024 / 1024",
            "legendFormat": "mcp-proxy (MiB)",
            "refId": "B"
          }
        ],
        "yAxes": [
          {"label": "MiB", "format": "mebibyte"},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "Service Status",
        "type": "table",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 14},
        "targets": [
          {
            "expr": "up{job=~\"lumen-chain|dashboard|email-capture|perps-funding-pulse|mcp-proxy\"}",
            "format": "table",
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true, "Value": true},
              "indexByName": {},
              "renameByName": {
                "__name__": "metric",
                "job": "service",
                "instance": "instance"
              }
            }
          }
        ]
      },
      {
        "id": 8,
        "title": "x402 Spend (perps-funding-pulse)",
        "type": "graph",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 14},
        "targets": [
          {
            "expr": "sum(increase(http_requests_total{job=\"perps-funding-pulse\", code=\"402\"}[1h]))",
            "legendFormat": "402 payments (1h)",
            "refId": "A"
          },
          {
            "expr": "sum(rate(x402_spend_usdc_total[5m]))",
            "legendFormat": "spend rate (USDC/min)",
            "refId": "B"
          }
        ],
        "yAxes": [
          {"format": "short"},
          {"format": "currencyUSD"}
        ]
      }
    ]
  }
}
