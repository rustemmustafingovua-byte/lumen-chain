# lumen-chain environment variables
# Скопируйте в .env и заполните значения.

# ---- Node / Explorer ----
LUMEN_HOME=/data/.lumen
LUMEN_RPC_PORT=8899
LUMEN_P2P_PORT=8789
LUMEN_X402_PRICE_USDC=1000
LUMEN_PEERS=
BASE_RPC=https://mainnet.base.org
LUMEN_KEEPER_POLL_MS=300000

# ---- Docker ----
COMPOSE_PROJECT_NAME=lumen-chain

# ---- Backup ----
LUMEN_BACKUP_DIR=/opt/lumen-backups
LUMEN_BACKUP_RETENTION=7
