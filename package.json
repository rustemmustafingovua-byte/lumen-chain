{
  "name": "lumen-chain",
  "version": "0.2.0",
  "description": "Lumen — an open-source proof-of-stake chain with a native AMM, a P2P gossip network and an autonomous keeper that converts any asset into Lumen without an exchange.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lumen": "./dist/cli/lumen.js"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./crypto": "./dist/core/crypto.js",
    "./ledger": "./dist/core/ledger.js",
    "./chain": "./dist/core/chain.js",
    "./rpc": "./dist/core/rpc.js",
    "./p2p": "./dist/core/p2p.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cryptocurrency",
    "blockchain",
    "pos",
    "amm",
    "x402",
    "web3",
    "base",
    "solana",
    "lumen"
  ],
  "files": [
    "dist",
    "core",
    "cli",
    "keeper",
    "contracts",
    "docs",
    "README.md",
    "LICENSE",
    "LAUNCH.md"
  ],
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "node": "tsx cli/lumen.ts node",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rustemmustafingovua-byte/lumen-chain.git"
  },
  "bugs": {
    "url": "https://github.com/rustemmustafingovua-byte/lumen-chain/issues"
  },
  "homepage": "https://github.com/rustemmustafingovua-byte/lumen-chain#readme",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts"
}
